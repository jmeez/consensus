# Copy to .env (or export in your shell) and fill in.
# Without a key the app still runs — Nova answers from the built-in offline mock.

# Anthropic API key for the server-side proxy (server/index.mjs).
# Never expose this to the browser.
ANTHROPIC_API_KEY=

# Model used for Nova responses. Defaults to claude-opus-5.
# NOVA_MODEL=claude-opus-5

# Port for the API proxy (defaults to 8787).
# PORT=8787
